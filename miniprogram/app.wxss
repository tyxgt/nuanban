/* app.wxss - 全局蓝色天空主题样式 */
page {
  --bg: #FFFFFF;
  --card: #FFFFFF;
  --primary: #3A7BD5;
  --primary-light: #E8F2FC;
  --primary-dark: #2C5FA8;
  --text: #1A1A1A;
  --text-secondary: #666666;
  --text-light: #999999;
  --border: #F0F0F0;
  --success: #4CAF7D;
  --success-light: #E3F5EC;
  --warning: #F5A623;
  --warning-light: #FFF8E1;
  --danger: #E5524A;
  --danger-light: #FFEBE9;
  --blue: #4A90D9;
  --blue-light: #E8F2FC;
  --hero-gradient: linear-gradient(180deg, #7EC8FC 0%, #4A90D9 100%);
  --shadow-soft: 0 4px 20px rgba(58, 123, 213, 0.08);
  --shadow-card: 0 2px 12px rgba(0, 0, 0, 0.04);
  --shadow-button: 0 4px 12px rgba(58, 123, 213, 0.25);

  background: var(--bg);
  color: var(--text);
  font-size: 24px;
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", sans-serif;
}

/* 图片骨架屏（全局复用）：套在 overflow:hidden + 有圆角的容器内会自动被裁成对应形状 */
.img-skeleton {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, #F0F0F0 25%, #E4E9F0 37%, #F0F0F0 63%);
  background-size: 400% 100%;
  animation: img-skeleton-shimmer 1.4s ease infinite;
}
@keyframes img-skeleton-shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}
