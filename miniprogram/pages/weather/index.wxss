.weather-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: calc(100px + env(safe-area-inset-bottom));
}

/* === 用户栏 === */
.user-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.user-bar-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-icon {
  font-size: 48rpx;
}

.user-nickname {
  font-size: 48rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.user-nickname.unset {
  color: #999999;
  font-weight: 400;
}

.user-arrow {
  font-size: 48rpx;
  color: #999999;
}

/* === 页面标题 === */
.page-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 24rpx 16rpx;
}

.page-title {
  font-size: 66rpx;
  font-weight: 700;
  color: #1A1A1A;
}

/* === 定位栏 === */
.location-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx 24rpx;
}

.location-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.loc-icon {
  font-size: 40rpx;
}

.loc-text {
  font-size: 48rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.location-btn {
  padding: 10rpx 24rpx;
  font-size: 39rpx;
  color: #3A7BD5;
  background: #FFFFFF;
  border: 1rpx solid #D6E4F7;
  border-radius: 999rpx;
}

/* === Hero 天气卡片（蓝渐变） === */
.weather-hero {
  margin: 8rpx 24rpx 28rpx;
  background: linear-gradient(180deg, #7EC8FC 0%, #4A90D9 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.18);
}

.hero-date {
  font-size: 60rpx;
  opacity: 0.92;
  margin-bottom: 20rpx;
}

.hero-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-left {
  flex: 1;
  min-width: 260rpx;
  display: flex;
  flex-direction: column;
}

.weather-temp {
  font-size: 200rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -6rpx;
}

.weather-temp .degree {
  font-size: 108rpx;
  vertical-align: top;
  font-weight: 600;
  margin-left: 4rpx;
}

.weather-condition {
  font-size: 81rpx;
  font-weight: 500;
  margin-top: 12rpx;
}

.weather-range {
  font-size: 55rpx;
  opacity: 0.95;
  margin-top: 10rpx;
  white-space: nowrap;
}

.hero-right {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-bottom: 40px;
}

.hero-weather-icon {
  font-size: 250rpx;
  line-height: 1;
}

.hero-location {
  position: absolute;
  right: 50rpx;
  bottom: 30rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 80rpx;
  color: #FFFFFF;
  opacity: 0.85;
}

.hero-loc-icon {
  font-size: 40rpx;
}

.hero-loc-text {
  font-size: 50rpx;
  font-weight: 400;
}

/* === 内容区 === */
.weather-body {
  flex: 1;
  padding: 0 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* === 天气详情（三卡片横排） === */
.weather-details {
  display: flex;
  gap: 20rpx;
}

.detail-item {
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid #F0F0F0;
  border-radius: 24rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.detail-emoji {
  font-size: 66rpx;
  line-height: 1;
  margin-bottom: 10rpx;
}

.detail-label {
  font-size: 42rpx;
  color: #999999;
  margin-bottom: 6rpx;
}

.detail-value {
  font-size: 54rpx;
  font-weight: 700;
  color: #1A1A1A;
}

/* === 未来三天天气 === */
.forecast-section {
  background: #FFFFFF;
  border: 1rpx solid #F0F0F0;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.forecast-title {
  font-size: 51rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  padding-left: 4rpx;
}

.forecast-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.forecast-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid #F5F5F5;
  overflow: hidden;
}

.forecast-item:last-child {
  border-bottom: none;
}

.forecast-day-wrap {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.forecast-day {
  font-size: 51rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.forecast-date {
  font-size: 36rpx;
  color: #999999;
}

.forecast-icon-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.forecast-emoji {
  font-size: 60rpx;
  line-height: 1;
}

.forecast-text {
  font-size: 39rpx;
  color: #666666;
  white-space: nowrap;
}

.forecast-temps {
  flex: 0 0 auto;
  font-size: 51rpx;
  font-weight: 500;
  color: #1A1A1A;
  white-space: nowrap;
  text-align: right;
}

/* === 温馨提示（黄底） === */
.tip-card {
  background: #FFF8E1;
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #FAF0CC;
}

.tip-icon-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.tip-icon {
  font-size: 57rpx;
}

.tip-title {
  font-size: 51rpx;
  font-weight: 700;
  color: #8A6D1F;
}

.tip-content {
  font-size: 50rpx;
  color: #8A6D1F;
  line-height: 1.55;
  padding-left: 52rpx;
}

/* === 加载提示 === */
.loading-tip {
  text-align: center;
  font-size: 51rpx;
  color: #999999;
  padding: 40rpx;
}
