<view class="weather-page">
  <!-- 定位栏 -->
  <!-- <view class="location-bar">
    <view class="location-left">
      <text class="loc-icon">📍</text>
      <text class="loc-text">{{weather.location || '定位中...'}}</text>
    </view>
  </view> -->

  <!-- Hero 天气卡片（蓝渐变） -->
  <view class="weather-hero">
    <!-- 日期行 -->
    <view class="hero-date" wx:if="{{dateStr}}">今天 {{dateStr}} {{weekDay}}</view>

    <!-- 主体：左温度文字 / 右天气图标 -->
    <view class="hero-main">
      <view class="hero-left">
        <view class="weather-temp">{{weather.temp || '--'}}<text class="degree">°C</text></view>
        <view class="weather-condition">{{weather.text || ''}}</view>
        <view class="weather-range" wx:if="{{weather.tempMax}}">{{weather.tempMin}}°C ~ {{weather.tempMax}}°C</view>
      </view>
      <view class="hero-right">
        <view class="hero-weather-icon">{{weatherEmoji}}</view>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="weather-body">
    <!-- 未来三天天气 -->
    <view class="forecast-section" wx:if="{{forecast.length > 0}}">
      <view class="forecast-title">未来三天天气</view>
      <view class="forecast-list">
        <view class="forecast-item" wx:for="{{forecast}}" wx:key="date">
          <view class="forecast-day-wrap">
            <view class="forecast-day">{{item.dayName}}</view>
            <view class="forecast-date" wx:if="{{item.dateShort}}">{{item.dateShort}}</view>
          </view>
          <view class="forecast-icon-wrap">
            <view class="forecast-emoji">{{item.emoji}}</view>
            <view class="forecast-text">{{item.textDay || ''}}</view>
          </view>
          <view class="forecast-temps">{{item.tempMin}}°C ~ {{item.tempMax}}°C</view>
        </view>
      </view>
    </view>
    
    <!-- 天气详情（横排三卡片） -->
    <view class="weather-details" wx:if="{{weather.humidity}}">
      <view class="detail-item">
        <view class="detail-emoji">💧</view>
        <view class="detail-label">湿度</view>
        <view class="detail-value">{{weather.humidity}}%</view>
      </view>
      <view class="detail-item">
        <view class="detail-emoji">🍃</view>
        <view class="detail-label">风力</view>
        <view class="detail-value">{{weather.windScale}}级</view>
      </view>
      <view class="detail-item">
        <view class="detail-emoji">☀️</view>
        <view class="detail-label">紫外线</view>
        <view class="detail-value">{{weather.uvText || '弱'}}</view>
      </view>
    </view>
    <!-- 温馨提示（黄底） -->
    <view class="tip-card" wx:if="{{tipText}}">
      <view class="tip-icon-wrap">
        <text class="tip-icon">🔔</text>
        <text class="tip-title">温馨提示</text>
      </view>
      <view class="tip-content">{{tipText}}</view>
    </view>




    <!-- 加载提示 -->
    <view class="loading-tip" wx:if="{{loading}}">正在获取天气...</view>
  </view>
</view>