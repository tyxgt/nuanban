.login-page {
  min-height: 100vh;
  background: #FFFFFF;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.login-header {
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

.login-title {
  font-size: 72rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.login-subtitle {
  font-size: 42rpx;
  color: #999999;
}

.login-form {
  margin-bottom: 60rpx;
}

.input-label {
  font-size: 45rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.nickname-input {
  height: 130rpx;
  font-size: 54rpx;
  padding: 0 28rpx;
  border: 2rpx solid #F0F0F0;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: #1A1A1A;
}

.nickname-placeholder {
  color: #CCCCCC;
  font-size: 48rpx;
}

.input-tip {
  font-size: 39rpx;
  color: #999999;
  margin-top: 16rpx;
  padding-left: 8rpx;
}

.login-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  margin-top: 40rpx;
}

.btn-primary {
  width: 100%;
  height: 130rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(180deg, #7EC8FC 0%, #4A90D9 100%);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(58, 123, 213, 0.25);
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.btn-primary::after {
  border: none;
}

.btn-text {
  font-size: 42rpx;
  color: #999999;
  padding: 16rpx 32rpx;
}
