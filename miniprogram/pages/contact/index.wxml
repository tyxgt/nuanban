<view class="contact-page">
  <!-- 紧急联系主卡片 -->
  <view class="call-card">
    <view class="call-card-icon">
      <view class="phone-handset"></view>
    </view>
    <view class="call-card-info">
      <view class="call-card-label">紧急联系电话</view>
      <view class="call-card-number">{{phoneNumber}}</view>
      <view class="call-card-hint">点击下方按钮立即拨打</view>
    </view>
  </view>

  <!-- 大拨号按钮 -->
  <view class="call-btn" bindtap="onCallTap">
    <text class="call-btn-icon">📞</text>
    <text class="call-btn-text">立即拨打</text>
  </view>

  <!-- 拨打提示 -->
  <view class="tips-card">
    <view class="tips-header">
      <text class="tips-icon">💡</text>
      <text class="tips-title">拨打提示</text>
    </view>
    <view class="tips-content">点击上方按钮将直接拨打 {{phoneNumber}}，可在系统弹窗中确认后拨出。</view>
  </view>
</view>
