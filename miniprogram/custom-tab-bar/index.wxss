.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 76px;
  background: #FFFFFF;
  border-top: 1px solid #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  color: #444444;
  padding: 10px 8px;
}

.tab-item.active {
  color: #3A7BD5;
}

.tab-item.active::before {
  content: '';
  position: absolute;
  top: -1px;
  width: 50px;
  height: 3px;
  background: #3A7BD5;
  border-radius: 0 0 3px 3px;
}

.tab-label {
  font-size: 32px;
  font-weight: 500;
}

.tab-item.active .tab-label {
  font-weight: 700;
}
