.loading-spinner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  border: 1rpx solid #F0F0F0;
  box-shadow: 0 8rpx 24rpx rgba(58, 123, 213, 0.12);
}

.spinner-icon {
  width: 96rpx;
  height: 96rpx;
  border: 10rpx solid #E0E8F0;
  border-top-color: #3A7BD5;
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.7s linear infinite;
}

.spinner-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #666666;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
